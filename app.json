{
  "expo": {
    "name": "MANNA",
    "slug": "scripture-path",
    "version": "1.0.0",
    "scheme": "manna",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "icon": "./assets/icon.png",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.scripturepath.app",
      "usesAppleSignIn": true,
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.scripturepath.app",
      "adaptiveIcon": {
        "backgroundColor": "#18201C",
        "foregroundImage": "./assets/android-icon-foreground.png"
      }
    },
    "plugins": [
      "expo-router",
      "expo-font",
      "expo-apple-authentication",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 180,
          "resizeMode": "contain",
          "backgroundColor": "#18201C"
        }
      ],
      [
        "expo-system-ui",
        {
          "style": "automatic"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "updates": {
      "url": "https://u.expo.dev/36e64c67-be88-4250-b108-bcd2318475c8",
      "fallbackToCacheTimeout": 0
    },
    "runtimeVersion": {
      "policy": "fingerprint"
    },
    "extra": {
      "eas": {
        "projectId": "36e64c67-be88-4250-b108-bcd2318475c8"
      }
    }
  }
}
