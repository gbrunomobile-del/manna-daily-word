{
  "expo": {
    "name": "Manna: Daily Word",
    "slug": "scripture-path",
    "version": "1.0.0",
    "scheme": "manna",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "icon": "./assets/icon.png",
    "splash": {
      "backgroundColor": "#18201C",
      "resizeMode": "contain",
      "image": "./assets/icon.png"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.scripturepath.app",
      "buildNumber": "2",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.scripturepath.app",
      "adaptiveIcon": {
        "backgroundColor": "#18201C",
        "foregroundImage": "./assets/android-icon-foreground.png"
      }
    },
    "plugins": [
      "expo-router",
      "expo-font",
      "expo-splash-screen",
      [
        "expo-system-ui",
        {
          "style": "automatic"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "eas": {
        "projectId": "36e64c67-be88-4250-b108-bcd2318475c8"
      }
    }
  }
}
